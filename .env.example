# Bella — environment template.
#
#   cp .env.example .env
#
# This is the ONLY env file that is committed. Real values live in .env locally and in
# Secret Manager everywhere else. Never put a working credential in this file.
#
# Compose supplies its own values for the containerised services (see compose.yaml);
# this file is for host-side tooling and for overriding those defaults.

# ── application ───────────────────────────────────────────────────────────────
ENVIRONMENT=local              # local | test | preview | staging | production
DEBUG=true
LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console for humans, json everywhere else

# ── networking ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*

# ── datastores ────────────────────────────────────────────────────────────────
# The runtime role has DML rights only, so Row-Level Security actually applies to it.
DATABASE_URL=postgresql://bella_app:bella_app_local@localhost:5432/bella
REDIS_URL=redis://localhost:6379/0

# ── auth ──────────────────────────────────────────────────────────────────────
# Generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-only-not-a-real-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
FIREBASE_PROJECT_ID=

# ── providers ─────────────────────────────────────────────────────────────────
# `mock` routes through the local stub server so development needs no vendor account
# and no request is ever billed.
LLM_PROVIDER=mock
LLM_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=

# ── storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local          # local | gcs
STORAGE_LOCAL_PATH=/var/lib/bella/storage
STORAGE_BUCKET_UPLOADS=bella-uploads

# ── mail ──────────────────────────────────────────────────────────────────────
# Mailpit catches everything locally: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=bella@localhost

# ── observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ── web ───────────────────────────────────────────────────────────────────────
# API_INTERNAL_URL is server-to-server inside the Docker network.
# NEXT_PUBLIC_API_URL is what the browser sees and is therefore public.
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
